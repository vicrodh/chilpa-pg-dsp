root = Path(__file__).resolve().parent.parent
catalog = json.loads((root / "profiles" / "catalog.json").read_text())
revision = catalog["revision"]
measured = [(profile["id"], profile["name"], profile["source"], profile["path"], profile["description"])
            for profile in catalog["profiles"]]
origins = []
for id, name, source, path, description in measured:
    text = (root / "profiles" / "autoeq" / f"{id}.txt").read_text()
    preamp = float(re.search(r"Preamp: ([\d.+-]+) dB", text)[1])
    filters = []
    for kind, frequency, gain, q in re.findall(r"Filter \d+: ON (\w+) Fc ([\d.]+) Hz Gain ([\d.+-]+) dB Q ([\d.]+)", text):
        filters.append(band({"PK": "peak", "LSC": "low_shelf", "HSC": "high_shelf"}[kind], float(frequency), float(gain), float(q)))
    assert len(filters) == 10, id
    assert -60 <= preamp <= 0, id
    for setting in filters:
        assert 10 <= setting["frequency"] <= 24000, id
        assert -24 <= setting["gain_db"] <= 18, id
        assert 0.1 <= setting["q"] <= 12, id
    url = "https://github.com/jaakkopasanen/AutoEq/blob/" + revision + "/" + urllib.parse.quote(path)
    add(id, name, "Audífonos", description, filters, preamp_db=preamp, source="AutoEq · " + source, source_url=url)
    origins.append(dict(id=id, path=path, revision=revision, source=source, license="MIT", url=url))

add("soundbar-21", "Soundbar 2.1 · voz y graves controlados", "Soundbars", "Ajuste genérico para barras 2.1, incluida Creative Stage V2: menos retumbe y más claridad vocal. No es una corrección medida de ese modelo. Empieza con el modo de sonido neutro de la barra.", [hp(35), low(130, -2.5), peak(2300, 1.5, 0.8)], source="Chilpa · ajuste genérico sin medición del equipo")
assert len(PRESETS) <= 128
assert len({preset["id"] for preset in PRESETS}) == len(PRESETS)
(root / "profiles" / "ORIGIN.json").write_text(json.dumps(origins, ensure_ascii=False, indent=2) + "\n")
spanish = {p["id"]: {key: p.get(key, "") for key in ("name", "category", "description", "source")} for p in PRESETS}
english = json.loads((root / "translations" / "en.json").read_text())
categories = {"Base": "Base", "Tono": "Tone", "Audífonos": "Headphones", "Bocinas": "Speakers",
              "Música": "Music", "Uso diario": "Everyday", "Canales": "Channels", "Soundbars": "Soundbars"}
measured_notes = {
    "hd650": "AutoEq profile from Rtings measurements. Response varies with earpads, fit and individual units.",
    "edition-xs": "AutoEq profile from Rtings 5128 measurements. Adjust bass and treble for the seal and your preference.",
    "pxc550": "AutoEq profile measured wirelessly with ANC on. Use that mode and disable other headphone effects.",
    "pxc550-ii": "AutoEq profile from Rtings measurements of the II model. ANC mode, seal and internal effects affect the result.",
}
for preset in PRESETS:
    preset["category"] = categories[preset["category"]]
    if preset.get("source_url"):
        preset["description"] = measured_notes.get(preset["id"],
            f"AutoEq profile from {preset['source'].removeprefix('AutoEq · ')} measurements. Fit, earpads or tips and audio mode affect the result.")
        if preset["id"] == "pxc550":
            preset["name"] = "Sennheiser PXC 550 · wireless, ANC on"
    else:
        preset["name"], preset["description"] = english[preset["id"]]
    if preset["id"] == "soundbar-21":
        preset["source"] = "Chilpa · generic adjustment without device measurements"
encode = lambda value: json.dumps(value, ensure_ascii=False, separators=(",", ":"))
rows = ",\n".join(encode(preset) for preset in PRESETS)
labels = ",\n".join(encode(id) + ":" + encode(text) for id, text in spanish.items())
(root / "presets.json").write_text('{"protocol":1,"presets":[\n' + rows + '\n],"localizations":{"es":{\n' + labels + '\n}}}\n')
print(f"Wrote {len(PRESETS)} bilingual presets ({len(measured)} measured AutoEq profiles)")
