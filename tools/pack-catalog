#!/usr/bin/env python3
"""Pack bounded independently compressed catalog pages for the offline WASM guest."""
import hashlib
import json
from pathlib import Path
import struct
import zlib

root=Path(__file__).resolve().parent.parent
folder=root/'profiles/library'
rows=[json.loads(line) for line in (folder/'presets.jsonl').read_text().splitlines()]
page=64
chunks=[zlib.compress((''.join(json.dumps(row,ensure_ascii=False,separators=(',',':'))+'\n' for row in rows[i:i+page])).encode(),9) for i in range(0,len(rows),page)]
header=4+len(chunks)*8
table=bytearray(struct.pack('<I',len(chunks)))
offset=header
for chunk in chunks:
    table.extend(struct.pack('<II',offset,len(chunk)))
    offset+=len(chunk)
(folder/'catalog.bin').write_bytes(table+b''.join(chunks))
index=''.join('\t'.join([str(i),row['id'],row['name'].lower(),row['source'].lower(),''.join(char for char in (row['name']+' '+row['source']).lower() if char.isalnum())])+'\n' for i,row in enumerate(rows))
(folder/'index.tsv').write_text(index)
origin=json.loads((folder/'ORIGIN.json').read_text())
origin.update(packed_sha256=hashlib.sha256((folder/'catalog.bin').read_bytes()).hexdigest(),shard_presets=page)
(folder/'ORIGIN.json').write_text(json.dumps(origin,ensure_ascii=False,indent=2)+'\n')
print(f'Packed {len(rows)} profiles in {len(chunks)} bounded shards; {offset} bytes plus {len(index.encode())} index bytes.')
