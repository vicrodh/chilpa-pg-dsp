#!/usr/bin/env python3
"""I generate listening curves and measured headphone corrections."""
import json
import re
import urllib.parse
from pathlib import Path

PRESETS = []

def band(shape, frequency, gain=0, q=0.7071067811865476):
    return dict(shape=shape, frequency=frequency, gain_db=gain, q=q)

def peak(frequency, gain, q=1):
    return band("peak", frequency, gain, q)

def low(frequency, gain):
    return band("low_shelf", frequency, gain)

def high(frequency, gain):
    return band("high_shelf", frequency, gain)

def hp(frequency):
    return band("high_pass", frequency)

def add(id, name, category, description, filters=(), **settings):
    PRESETS.append(dict(id=id, name=name, category=category, description=description,
                        filters=list(filters), **settings))

